# Copy this file to .env and fill in real values. NEVER commit the real .env.

# --- Webhook ---
WEBHOOK_SECRET_PATH=change-me-random-string
WORKFLOW2_WEBHOOK_URL=https://YOUR-NGROK-DOMAIN/webhook/your-followup-secret-path

# --- Twilio ---
ENFORCE_TWILIO_SIG=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# --- Business identity ---
BUSINESS_NAME=Example Business
BUSINESS_PHONE=+15555550100
OWNER_PHONE=+15555550101
OWNER_EMAIL=owner@example.com
BOOKING_LINK=https://calendly.com/example

# --- Google Sheets ---
GOOGLE_SHEETS_ID=your-google-sheet-id

# --- SMTP (owner email notifications) ---
SMTP_FROM_EMAIL=alerts@example.com
